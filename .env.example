# DevPocket Environment Configuration
# Copy this file to .env.local for development

# Base Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub Repository Link (optional)
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/example/devpocket

# Optional Contact Form Email Delivery
# If left blank, the API handler runs in honest mock mode and logs submission safely without false delivery claims.
# Supported provider credentials (e.g. Resend, SendGrid, or custom SMTP):
CONTACT_EMAIL_PROVIDER=mock
CONTACT_EMAIL_TO=ranit.das.1321@gmail.com
CONTACT_EMAIL_FROM=notifications@devpocket.dev
RESEND_API_KEY=

# Optional Analytics (Privacy-focused: Plausible, Fathom, or Umami)
# Privacy-first: Analytics scripts are never loaded without user consent
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_ANALYTICS_DOMAIN=
